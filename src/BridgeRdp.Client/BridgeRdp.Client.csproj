<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- mstsc.exe на x64 Windows — 64-битный процесс, плагин должен совпадать по разрядности -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Генерирует BridgeRdp.Client.comhost.dll — нативную COM-точку входа, которую грузит mstsc -->
    <EnableComHosting>true</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BridgeRdp.Files\BridgeRdp.Files.csproj" />
    <ProjectReference Include="..\BridgeRdp.Proxy\BridgeRdp.Proxy.csproj" />
    <ProjectReference Include="..\BridgeRdp.Protocol\BridgeRdp.Protocol.csproj" />
  </ItemGroup>

</Project>
